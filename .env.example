# VestyHub — exemple sans secret réel.
# Copiez en .env, remplacez toutes les valeurs "change-me", puis protégez le fichier.

NODE_ENV=production
APP_NAME=VestyHub
APP_URL=https://dashboard.example.com
APP_PORT=3000

# Génération : openssl rand -hex 32
APP_ENCRYPTION_KEY=
AUTH_SECRET=

POSTGRES_USER=vestyhub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vestyhub
DATABASE_URL=postgresql://vestyhub:change-me@postgres:5432/vestyhub

AUTH_LOCAL_ENABLED=true
AUTHENTIK_ENABLED=false
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# Phase 3C — sources internes du profil Docker Compose "monitoring".
# Laissez une valeur vide lorsque la source n'est pas utilisée.
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_TIMEOUT_MS=5000
LOKI_URL=http://loki:3100
LOKI_TIMEOUT_MS=5000
ALERTMANAGER_URL=http://alertmanager:9093
ALERTMANAGER_TIMEOUT_MS=5000
PROMETHEUS_RETENTION=30d

# Phase 3O — ntfy auto-hébergé.
# Le token réel ne doit jamais être commité.
NTFY_PORT=8093
NTFY_ALERTMANAGER_TOKEN_FILE=./secrets/ntfy-alertmanager.runtime.token

# Phase 3A — source Docker NAS obligatoire.
# Production sur le NAS : http://vestyhub-docker-proxy:2375
# Docker Desktop + tunnel SSH : http://host.docker.internal:23750
# pnpm dev + tunnel SSH : http://127.0.0.1:23750
DOCKER_PROXY_URL=http://vestyhub-docker-proxy:2375
# Valeur exacte retournée par GET /info dans le champ Name.
DOCKER_EXPECTED_HOSTNAME=change-me-nas-hostname
DOCKER_CONTROL_ENABLED=false
DOCKER_LOGS_ENABLED=true

# Phase 3D — DSM en lecture seule.
# Utilisez idéalement une URL HTTPS avec un certificat approuvé.
# Exemple LAN DSM direct : https://192.168.1.5:5001
# Exemple reverse proxy : https://nas.example.com
SYNOLOGY_ENABLED=false
SYNOLOGY_MODE=dsm-api
SYNOLOGY_BASE_URL=
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=
SYNOLOGY_TIMEOUT_MS=8000
SYNOLOGY_VERIFY_TLS=true
# Chemin à l'intérieur du conteneur vers une CA privée PEM, si nécessaire.
SYNOLOGY_CA_CERT_PATH=

# Phase 3E — SNMPv3 chiffré pour les disques, volumes et états RAID.
# Configurez DSM avec Auth SHA + confidentialité AES.
# Ces secrets sont transmis uniquement au conteneur snmp-exporter.
SNMPV3_USERNAME=
SNMPV3_AUTH_PASSWORD=
SNMPV3_PRIV_PASSWORD=

HEALTHCHECK_ALLOWED_HOSTS=
HEALTHCHECK_ALLOWED_CIDRS=192.168.0.0/16,10.0.0.0/8

DEFAULT_REFRESH_INTERVAL=15000
LOG_LEVEL=info
DEMO_MODE=false

SEED_ADMIN_EMAIL=admin@vestyhub.local
SEED_ADMIN_PASSWORD=

VESTYHUB_IMAGE_TAG=v0.3.0
