# VestyHub — exemple sans secret réel.
# Copiez en .env, remplacez toutes les valeurs "change-me", puis protégez le fichier.

NODE_ENV=production
APP_NAME=VestyHub
APP_URL=https://dashboard.example.com
APP_PORT=3000

# Génération : openssl rand -hex 32
APP_ENCRYPTION_KEY=
AUTH_SECRET=

POSTGRES_USER=vestyhub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vestyhub
DATABASE_URL=postgresql://vestyhub:change-me@postgres:5432/vestyhub

AUTH_LOCAL_ENABLED=true
AUTHENTIK_ENABLED=false
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# Laissez vide si vous n'utilisez pas la source. Avec le profil monitoring :
# PROMETHEUS_URL=http://prometheus:9090
# LOKI_URL=http://loki:3100
# ALERTMANAGER_URL=http://alertmanager:9093
PROMETHEUS_URL=
PROMETHEUS_TIMEOUT_MS=5000
LOKI_URL=
LOKI_TIMEOUT_MS=5000
ALERTMANAGER_URL=
ALERTMANAGER_TIMEOUT_MS=5000
PROMETHEUS_RETENTION=30d

# Le proxy est uniquement joignable sur le réseau Docker interne.
DOCKER_PROXY_URL=http://docker-socket-proxy:2375
DOCKER_CONTROL_ENABLED=false
DOCKER_LOGS_ENABLED=true

SYNOLOGY_ENABLED=false
SYNOLOGY_MODE=hybrid
SYNOLOGY_BASE_URL=
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=
SYNOLOGY_VERIFY_TLS=true
# Chemin dans le conteneur vers une CA interne montée explicitement, si nécessaire.
SYNOLOGY_CA_CERT_PATH=

HEALTHCHECK_ALLOWED_HOSTS=
HEALTHCHECK_ALLOWED_CIDRS=192.168.0.0/16,10.0.0.0/8

DEFAULT_REFRESH_INTERVAL=15000
LOG_LEVEL=info
DEMO_MODE=false

# Utilisé uniquement avec : docker compose --profile seed run --rm seed
SEED_ADMIN_EMAIL=admin@vestyhub.local
# Obligatoire en production et dans tout mode non-démo. Minimum 12 caractères.
SEED_ADMIN_PASSWORD=

# Tag local des images construites par Compose.
VESTYHUB_IMAGE_TAG=phase2
